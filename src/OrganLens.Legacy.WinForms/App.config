<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
  </startup>
  <appSettings>
    <!-- false = read data\legacy-studies.xml (searched upwards from the exe folder) -->
    <add key="UseSql" value="false" />
    <add key="DataFile" value="data\legacy-studies.xml" />
  </appSettings>
  <connectionStrings>
    <add name="OrganLensDb" connectionString="Server=(localdb)\MSSQLLocalDB;Database=OrganLens;Integrated Security=true" />
  </connectionStrings>
</configuration>
